# Image tag for ghcr.io/metril/ntp-server. Pin to X.Y.Z in production.
NTP_SERVER_TAG=latest

# Local time grandmaster this chrony instance syncs from over NTP unicast.
GRANDMASTER_HOST=

# Identifies this collector in VictoriaMetrics/VictoriaLogs. Set to the host
# running this stack.
ALLOY_INSTANCE=

# VictoriaMetrics remote_write endpoint + basic auth.
VM_URL=https://victoriametrics.azureolympos.com/api/v1/write
VM_USER=
VM_PASSWORD=

# VictoriaLogs push endpoint (Loki push API) + basic auth.
VL_URL=https://victorialogs.azureolympos.com/insert/loki/api/v1/push
VL_USER=
VL_PASSWORD=

# GID of the `docker` group on the host, so the alloy container can read
# /var/run/docker.sock for `discovery.docker`. Find it with `getent group docker`.
DOCKER_GID=

# --- Optional ----------------------------------------------------------------

# Extra fallback NTP servers, space-separated. The template always adds
# time.cloudflare.com, time.nist.gov and pool 2.pool.ntp.org as fallbacks so a
# bad grandmaster is outvoted (>=3 sources total).
POOL_SERVERS=

# Server-side rate limiting (see chrony.conf.template's `ratelimit` line).
RATELIMIT_INTERVAL=3
RATELIMIT_BURST=8
# leak N: still answer 1 in 2^N rate-limited requests (chrony default 2).
RATELIMIT_LEAK=2
CLIENTLOGLIMIT=16777216

# --- NTS (optional) ------------------------------------------------------
# Cert/key are provided and renewed externally; the DIRECTORY containing
# them is mounted read-only via compose.nts.yaml (not the files themselves -
# renewal tools like certbot replace files/symlinks in place, which would
# orphan a file-level bind mount). chronyd cannot hot-reload a renewed cert
# (chrony 4.5 docs: "chronyd needs to be restarted in order to load a
# renewed certificate") so the entrypoint watches the mounted directory with
# inotify and exits the container on change; `restart: unless-stopped`
# brings it back with the new cert. Requires a local-filesystem bind mount
# (inotify events don't propagate over network filesystems).
NTS_ENABLED=false

# Simplest with Let's Encrypt: point this at /etc/letsencrypt itself (not
# just live/<host>) so the live/ -> archive/ symlinks resolve inside the
# container, then set the names below with the live/<host>/ prefix.
#   NTS_CERT_DIR=/etc/letsencrypt
#   NTS_CERT_NAME=live/example.com/fullchain.pem
#   NTS_KEY_NAME=live/example.com/privkey.pem
NTS_CERT_DIR=
# Paths are relative to NTS_CERT_DIR. Defaults below assume NTS_CERT_DIR
# points directly at a folder containing fullchain.pem/privkey.pem.
NTS_CERT_NAME=fullchain.pem
NTS_KEY_NAME=privkey.pem

# --- Client geography + pool.ntp.org score (optional) -----------------------
# This server's public IPv4, used to poll its pool.ntp.org monitoring score.
# Leave empty to skip the ntppool collector.
NTPPOOL_IPV4=

# MaxMind GeoLite2 account credentials (free signup at maxmind.com), used by
# the geoipupdate sidecar to fetch GeoLite2-Country/GeoLite2-ASN. The
# geoipupdate service only runs under the "geoip" compose profile (start it
# with `--profile geoip` or COMPOSE_PROFILES=geoip once these are set).
# Without the DBs, ntp-clients-exporter still runs but everything reports
# country="unknown".
GEOIPUPDATE_ACCOUNT_ID=
GEOIPUPDATE_LICENSE_KEY=

# Number of top ASNs to keep as distinct label values before folding the
# rest into asn="other" (bounds metric cardinality).
NTP_ASN_TOP_N=25

# Seconds between metric flushes of the passive capture aggregator.
CLIENTS_POLL_INTERVAL=15
